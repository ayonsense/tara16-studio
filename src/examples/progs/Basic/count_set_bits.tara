; Population count (Hamming weight): count the 1-bits of a 16-bit value.
;
; Algorithm:
;   count = 0
;   while value != 0:
;       count += value & 1
;       value  = value >> 1
;
; Registers: R1 = value, R2 = count, R3 = mask(1), R4 = scratch.
; The demo value 0xB3B5 has 10 set bits, so R2 = 10 after HLT.

        LIL  R1, 0xB5
        LIH  R1, 0xB3       ; R1 = 0xB3B5
        LIL  R2, 0          ; count = 0
        LIL  R3, 1          ; mask = 1

loop:   BZ   R1, done       ; no bits left
        MOV  R4, R1
        AND  R4, R4, R3     ; R4 = value & 1
        ADD  R2, R2, R4     ; count += low bit
        SHR  R1, 1          ; value >>= 1
        JMP  loop

done:   HLT                 ; R2 = 10
