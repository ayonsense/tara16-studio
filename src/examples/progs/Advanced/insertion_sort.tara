; Insertion sort for a byte array.
;
; Algorithm:
;   for i = 1 .. N-1:
;       key = A[i]
;       slide every earlier element greater than key one slot right,
;       then drop key into the gap.
;   Equal elements keep their order, so the sort is stable.
;
; Input contract:
;   A[0..255] is already stored at byte addresses 0x0400..0x04FF.
;   The 256 unsigned byte values are sorted ascending in place.
;   This program does not seed or otherwise overwrite the input before sorting.
;
; Registers: R0 = base, R1 = N, R2 = i ptr, R3 = key, R4 = j ptr,
;            R5 = A[j], R6 = end ptr, R7 = scratch.

        LIL  R0, 0
        LIH  R0, 4          ; base = 0x0400
        LIL  R1, 0
        LIH  R1, 1          ; N = 0x0100 = 256 bytes

sort:   MOV  R2, R1
        ADDI R2, -1
        BZ   R2, done       ; N == 1
        BN   R2, done       ; N == 0

        ADD  R6, R0, R1     ; end = base + N
        MOV  R2, R0
        ADDI R2, 1          ; i = base + 1

outer:  SUB  R7, R2, R6
        BZ   R7, done       ; i == end
        BN   R7, insert     ; i <  end
        JMP  done

insert: LDB  R3, 0(R2)      ; key = A[i]
        MOV  R4, R2
        ADDI R4, -1         ; j = i - 1

inner:  SUB  R7, R4, R0
        BN   R7, place      ; j < base
        LDB  R5, 0(R4)      ; A[j]
        SUB  R7, R5, R3
        BN   R7, place      ; A[j] < key
        BZ   R7, place      ; A[j] == key (stable)
        STB  R5, 1(R4)      ; shift A[j] right
        ADDI R4, -1
        JMP  inner

place:  STB  R3, 1(R4)      ; drop key into the gap
        ADDI R2, 1          ; i++
        JMP  outer

done:   HLT
