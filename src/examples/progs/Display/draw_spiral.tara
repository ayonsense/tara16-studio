; Rectangular spiral demo for the TARA memory-mapped display.
;
; Display:
;   0x0600-0x07FF framebuffer
;   64x64 pixels, 1 bit per pixel, 8 horizontal pixels per byte
;
; The program repeatedly:
;   1. draws dashed rectangular rings from the outer periphery toward the center
;   2. clears those dashed rings from the center back outward
; It loops forever.
;
; Scratch state at 0x0400:
;   +0 color, +1 layer, +2 left, +3 top, +4 right, +5 bottom
;   +6 current x, +7 current y, +8 left-column minimum y

        LIL  R7, 240
        LIH  R7, 5          ; stack top = 0x05F0

        CALL clear_display

main_loop:
        CALL draw_inward
        CALL clear_outward
        JMP  main_loop


; ---- draw_inward ----------------------------------------------------
; Draw layers 0..31, so the visible spiral moves from periphery to center.
draw_inward:
        PUSH R6
        LIL  R1, 0          ; layer

draw_in_loop:
        LIL  R2, 32
        SLT  R3, R1, R2     ; while layer < 32
        BZ   R3, draw_in_done
        PUSH R1
        LIL  R0, 1          ; draw color
        CALL draw_ring
        POP  R1
        ADDI R1, 1
        JMP  draw_in_loop

draw_in_done:
        POP  R6
        RET


; ---- clear_outward --------------------------------------------------
; Clear layers 31..0, so erasing expands from center to periphery.
clear_outward:
        PUSH R6
        LIL  R1, 31         ; layer

clear_out_loop:
        PUSH R1
        LIL  R0, 0          ; erase color
        CALL draw_ring
        POP  R1
        BZ   R1, clear_out_done
        ADDI R1, -1
        JMP  clear_out_loop

clear_out_done:
        POP  R6
        RET


; ---- draw_ring ------------------------------------------------------
; Inputs:
;   R0 = color, 0 draw off / 1 draw on
;   R1 = layer, 0 outermost .. 31 innermost
; Draws one rectangular ring without repeating corner pixels.
; Each edge advances by two pixels, leaving one off pixel between plotted pixels.
draw_ring:
        PUSH R6
        LIL  R5, 0
        LIH  R5, 4          ; R5 = state base 0x0400

        STB  R0, 0(R5)      ; color
        STB  R1, 1(R5)      ; layer
        STB  R1, 2(R5)      ; left = layer
        STB  R1, 3(R5)      ; top  = layer
        LIL  R2, 63
        SUB  R2, R2, R1
        STB  R2, 4(R5)      ; right  = 63 - layer
        STB  R2, 5(R5)      ; bottom = 63 - layer

        ; Top edge: x = left..right by 2, y = top.
        LDB  R2, 2(R5)
        STB  R2, 6(R5)      ; x = left
        LDB  R2, 3(R5)
        STB  R2, 7(R5)      ; y = top

top_loop:
        LIL  R5, 0
        LIH  R5, 4
        LDB  R0, 0(R5)
        LDB  R1, 6(R5)
        LDB  R2, 7(R5)
        CALL plot_pixel

        LIL  R5, 0
        LIH  R5, 4
        LDB  R1, 6(R5)
        ADDI R1, 2
        STB  R1, 6(R5)
        LDB  R2, 4(R5)
        SLT  R3, R2, R1     ; done when right < x
        BZ   R3, top_loop
        JMP  top_done

top_done:
        ; Right edge: x = right, y = top + 1..bottom by 2.
        LDB  R2, 4(R5)
        STB  R2, 6(R5)      ; x = right
        LDB  R2, 3(R5)
        ADDI R2, 1
        STB  R2, 7(R5)      ; y = top + 1

right_loop:
        LIL  R5, 0
        LIH  R5, 4
        LDB  R0, 0(R5)
        LDB  R1, 6(R5)
        LDB  R2, 7(R5)
        CALL plot_pixel

        LIL  R5, 0
        LIH  R5, 4
        LDB  R1, 7(R5)
        ADDI R1, 2
        STB  R1, 7(R5)
        LDB  R2, 5(R5)
        SLT  R3, R2, R1     ; done when bottom < y
        BZ   R3, right_loop
        JMP  right_done

right_done:
        ; Bottom edge: x = right - 1..left by 2, y = bottom.
        LDB  R2, 4(R5)
        ADDI R2, -1
        STB  R2, 6(R5)      ; x = right - 1
        LDB  R2, 5(R5)
        STB  R2, 7(R5)      ; y = bottom

bottom_loop:
        LIL  R5, 0
        LIH  R5, 4
        LDB  R0, 0(R5)
        LDB  R1, 6(R5)
        LDB  R2, 7(R5)
        CALL plot_pixel

        LIL  R5, 0
        LIH  R5, 4
        LDB  R1, 6(R5)
        ADDI R1, -2
        STB  R1, 6(R5)
        LDB  R2, 2(R5)
        SLT  R3, R1, R2     ; done when x < left
        BZ   R3, bottom_loop
        JMP  bottom_done

bottom_done:
        ; Left edge: x = left, y = bottom - 1..top + 1 by 2.
        LDB  R2, 2(R5)
        STB  R2, 6(R5)      ; x = left
        LDB  R2, 5(R5)
        ADDI R2, -1
        STB  R2, 7(R5)      ; y = bottom - 1
        LDB  R2, 3(R5)
        ADDI R2, 1
        STB  R2, 8(R5)      ; minimum y = top + 1

        LDB  R1, 7(R5)
        LDB  R2, 8(R5)
        SLT  R3, R1, R2     ; skip left edge for the 2x2 center ring
        BZ   R3, left_loop
        JMP  ring_done

left_loop:
        LIL  R5, 0
        LIH  R5, 4
        LDB  R0, 0(R5)
        LDB  R1, 6(R5)
        LDB  R2, 7(R5)
        CALL plot_pixel

        LIL  R5, 0
        LIH  R5, 4
        LDB  R1, 7(R5)
        ADDI R1, -2
        STB  R1, 7(R5)
        LDB  R2, 8(R5)
        SLT  R3, R1, R2     ; done when y < minimum y
        BZ   R3, left_loop
        JMP  ring_done

ring_done:
        POP  R6
        RET


; ---- clear_display --------------------------------------------------
; Clears framebuffer bytes 0x0600..0x07FF.
clear_display:
        LIL  R0, 0
        LIL  R5, 0
        LIH  R5, 6          ; R5 = 0x0600
        LIL  R4, 0
        LIH  R4, 8          ; R4 = 0x0800

clear_loop:
        SUB  R3, R4, R5
        BZ   R3, clear_ret
        STB  R0, 0(R5)
        ADDI R5, 1
        JMP  clear_loop

clear_ret:
        RET


; ---- plot_pixel -----------------------------------------------------
; Inputs:
;   R0 = color 0..1
;   R1 = x, 0..63
;   R2 = y, 0..63
; Clobbers R2, R3, R4, R5. R6 is preserved as the return link.
plot_pixel:
        BN   R1, plot_ret
        BN   R2, plot_ret

        LIL  R5, 64
        SLT  R4, R1, R5
        BZ   R4, plot_ret

        LIL  R5, 64
        SLT  R4, R2, R5
        BZ   R4, plot_ret

        LIL  R4, 7
        AND  R3, R1, R4     ; pixel slot = x % 8

        MOV  R5, R2
        SHL  R5, 3          ; y * 8 bytes per row
        MOV  R4, R1
        SHR  R4, 3          ; x / 8
        ADD  R5, R5, R4
        LIL  R4, 0
        LIH  R4, 6
        ADD  R5, R5, R4     ; framebuffer byte address

        LDB  R4, 0(R5)      ; existing packed byte

        BZ   R3, pix_slot0
        ADDI R3, -1
        BZ   R3, pix_slot1
        ADDI R3, -1
        BZ   R3, pix_slot2
        ADDI R3, -1
        BZ   R3, pix_slot3
        ADDI R3, -1
        BZ   R3, pix_slot4
        ADDI R3, -1
        BZ   R3, pix_slot5
        ADDI R3, -1
        BZ   R3, pix_slot6
        JMP  pix_slot7

pix_slot0:
        LIL  R2, 127        ; clear bit 7
        AND  R4, R4, R2
        BZ   R0, pix_store
        LIL  R2, 128
        OR   R4, R4, R2
        JMP  pix_store

pix_slot1:
        LIL  R2, 191        ; clear bit 6
        AND  R4, R4, R2
        BZ   R0, pix_store
        LIL  R2, 64
        OR   R4, R4, R2
        JMP  pix_store

pix_slot2:
        LIL  R2, 223        ; clear bit 5
        AND  R4, R4, R2
        BZ   R0, pix_store
        LIL  R2, 32
        OR   R4, R4, R2
        JMP  pix_store

pix_slot3:
        LIL  R2, 239        ; clear bit 4
        AND  R4, R4, R2
        BZ   R0, pix_store
        LIL  R2, 16
        OR   R4, R4, R2
        JMP  pix_store

pix_slot4:
        LIL  R2, 247        ; clear bit 3
        AND  R4, R4, R2
        BZ   R0, pix_store
        LIL  R2, 8
        OR   R4, R4, R2
        JMP  pix_store

pix_slot5:
        LIL  R2, 251        ; clear bit 2
        AND  R4, R4, R2
        BZ   R0, pix_store
        LIL  R2, 4
        OR   R4, R4, R2
        JMP  pix_store

pix_slot6:
        LIL  R2, 253        ; clear bit 1
        AND  R4, R4, R2
        BZ   R0, pix_store
        LIL  R2, 2
        OR   R4, R4, R2
        JMP  pix_store

pix_slot7:
        LIL  R2, 254        ; clear bit 0
        AND  R4, R4, R2
        BZ   R0, pix_store
        LIL  R2, 1
        OR   R4, R4, R2

pix_store:
        STB  R4, 0(R5)

plot_ret:
        RET
