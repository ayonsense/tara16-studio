; ---------------------------------------------------------------------------
; Draw a filled triangle
; TARA assembly example  |  CS2300 - Foundations of Computer System Design
; Copyright (c) 2026 Ayon Chakraborty, IIT Madras.
; ---------------------------------------------------------------------------

; Display triangle demo for the TARA memory-mapped display.
;
; Display map:
;   0x0600-0x07FF  framebuffer
;   64x64 pixels, 1 bit per pixel, 8 horizontal pixels per byte
;   the leftmost pixel of a byte is bit 7; row 0 is at the bottom
;
; Triangle dimensions used here:
;   height = 24 pixels (rows 43 down to 20)
;   base   = 48 pixels (x = 8..55), centred on the screen
;
; The apex is at the top. Each row is one pixel wider on both sides
; than the row above it, so the edges are smooth 45-degree lines.
;
; A row covers pixels L..R. Only the two edge bytes are partly lit.
; Every byte between them is 0xFF. TARA can only shift by a constant,
; so the edge masks grow by one bit per row:
;   left mask:  0x01, 0x03, 0x07, ... 0xFF, then move one byte left
;   right mask: 0x80, 0xC0, 0xE0, ... 0xFF, then move one byte right

; ---- Clear framebuffer ---------------------------------------------
        LIL  R0, 0
        LIL  R6, 0
        LIH  R6, 6          ; R6 = 0x0600 framebuffer start
        LIL  R7, 0
        LIH  R7, 8          ; R7 = 0x0800 framebuffer end

clear_loop:
        SUB  R5, R7, R6
        BZ   R5, draw_setup
        STB  R0, 0(R6)
        ADDI R6, 1
        JMP  clear_loop

; ---- Draw filled triangle ------------------------------------------
; Registers:
;   R0 = address of the left edge byte
;   R1 = left edge mask
;   R2 = address of the right edge byte
;   R3 = right edge mask
;   R4 = rows left to draw
;   R5 = scratch
;   R6 = draw pointer
;   R7 = 0xFF, a full byte (8 lit pixels)

draw_setup:
        LIL  R0, 0x5B
        LIH  R0, 7          ; R0 = 0x075B = 0x0600 + 43*8 + 3, apex pixel x = 31
        LIL  R1, 0x01       ; x = 31 is the last pixel of its byte
        LIL  R2, 0x5C
        LIH  R2, 7          ; R2 = 0x075C, apex pixel x = 32
        LIL  R3, 0x80       ; x = 32 is the first pixel of its byte
        LIL  R4, 24         ; 24 rows
        LIL  R7, 255

row_loop:
        STB  R1, 0(R0)      ; left edge byte
        MOV  R6, R0

fill_loop:                  ; full bytes between the two edges
        ADDI R6, 1
        SUB  R5, R2, R6
        BZ   R5, right_edge
        STB  R7, 0(R6)
        JMP  fill_loop

right_edge:
        STB  R3, 0(R2)      ; right edge byte

        ADDI R4, -1
        BZ   R4, done

        ADDI R0, -8         ; next row down the screen
        ADDI R2, -8         ; (8 bytes per 64-pixel row)

; Widen the left edge by one pixel.
        SUB  R5, R1, R7
        BZ   R5, left_new_byte
        SHL  R1, 1          ; mask = mask << 1 | 1
        ADDI R1, 1
        JMP  widen_right

left_new_byte:
        ADDI R0, -1         ; byte was full: start the byte on its left
        LIL  R1, 0x01

; Widen the right edge by one pixel.
widen_right:
        SUB  R5, R3, R7
        BZ   R5, right_new_byte
        SHR  R3, 1          ; mask = mask >> 1 | 0x80
        LIL  R5, 0x80
        OR   R3, R3, R5
        JMP  row_loop

right_new_byte:
        ADDI R2, 1          ; byte was full: start the byte on its right
        LIL  R3, 0x80
        JMP  row_loop

done:
        HLT
